// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Plans
enum Plan {
  FREE
  PRO
}

// User Model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?

  plan          Plan      @default(FREE)
  stripeCustomerId String? @unique

  // Relations
  accounts      Account[]
  sessions      Session[]
  landings      Landing[]

  // Usage tracking
  aiGenerationsUsed Int @default(0)
  aiGenerationsResetAt DateTime @default(now())

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

// NextAuth Account Model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth Session Model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth Verification Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Landing Page Model
model Landing {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  slug          String
  description   String?   @db.Text  // Original user input for generation

  // Landing content stored as JSON
  content       Json      // { sections: Section[] }

  // Styling
  theme         Json      // LandingTheme object

  // Publishing
  published     Boolean   @default(false)
  publishedAt   DateTime?
  customDomain  String?   @unique

  // Analytics
  views         Int       @default(0)

  // Generation metadata
  generationPrompt String? @db.Text
  tokensUsed    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  images        GeneratedImage[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([customDomain])
  @@index([published])
}

// Generated Images (for tracking and potential reuse)
model GeneratedImage {
  id            String    @id @default(cuid())
  landingId     String
  landing       Landing   @relation(fields: [landingId], references: [id], onDelete: Cascade)

  prompt        String    @db.Text
  revisedPrompt String?   @db.Text  // DALL-E may revise the prompt
  url           String    // R2/S3 URL

  // Image metadata
  width         Int       @default(1024)
  height        Int       @default(1024)
  sectionId     String?   // Which section this image belongs to

  createdAt     DateTime  @default(now())

  @@index([landingId])
}

// Waitlist (for early access)
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // Where they signed up from
  createdAt DateTime @default(now())
}
